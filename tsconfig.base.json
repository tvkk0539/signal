{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@swarm/shared": ["./shared/src/index.ts"]
    },
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true
  },
  "exclude": ["node_modules"]
}